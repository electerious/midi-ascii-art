{
  "name": "midi-ascii-art",
  "version": "1.1.1",
  "description": "Generate beautiful ASCII art patterns in your terminal by playing MIDI keys",
  "keywords": [
    "midi",
    "ascii",
    "art",
    "visualizer",
    "terminal"
  ],
  "homepage": "https://github.com/electerious/midi-ascii-art",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/electerious/midi-ascii-art.git"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "midi-ascii-art": "bin/index.js"
  },
  "files": [
    "bin",
    "src"
  ],
  "scripts": {
    "eslint": "eslint \"**/*.js\"",
    "format": "npm run eslint -- --fix && npm run prettier -- --write",
    "lint": "npm run eslint && npm run prettier -- --check",
    "prettier": "prettier --ignore-path .gitignore \"**/*.{js,json,mjs,css,md}\"",
    "start": "./bin/index.js",
    "test": "npm run lint"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "easymidi": "^3.2.0"
  },
  "devDependencies": {
    "@electerious/eslint-config": "^6.0.0-rc.3",
    "@electerious/prettier-config": "^4.0.2",
    "eslint": "^10.8.1",
    "prettier": "^3.9.6"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "authors": [
    "Tobias Reich <tobias@electerious.com>"
  ]
}
